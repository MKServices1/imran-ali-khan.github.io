---
import { profile } from '@/data/profile';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-800">
  <div class="section flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-mono text-sm text-ink-50">{profile.name}</p>
      <p class="mt-1 text-sm text-ink-400">{profile.role} · {profile.location}</p>
    </div>

    <ul class="flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <li>
        <a href={`mailto:${profile.email}`} class="text-ink-300 transition-colors hover:text-signal">
          {profile.email}
        </a>
      </li>
      <li>
        <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="text-ink-300 transition-colors hover:text-signal">
          LinkedIn
        </a>
      </li>
      <li>
        <a href={profile.links.github} target="_blank" rel="noopener noreferrer" class="text-ink-300 transition-colors hover:text-signal">
          GitHub
        </a>
      </li>
    </ul>
  </div>

  <div class="section border-t border-ink-800 py-6">
    <p class="text-xs text-ink-500">© {year} {profile.name}. Built with Astro & Tailwind CSS.</p>
  </div>
</footer>
