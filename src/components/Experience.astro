---
import { experience, education } from '@/data/experience';
---

<section id="experience" class="section py-20 sm:py-28" aria-labelledby="experience-heading">
  <div class="reveal max-w-2xl">
    <p class="section-label">Experience</p>
    <h2 id="experience-heading" class="mt-3 text-3xl font-semibold text-ink-50 sm:text-4xl">
      4.5+ years, three companies, one focus
    </h2>
    <p class="mt-4 text-ink-400">
      Consistent Flutter experience across workforce tools, real-time messaging platforms, and production SaaS.
    </p>
  </div>

  <ol class="mt-14 space-y-14">
    {
      experience.map((role, index) => (
        <li class="reveal grid grid-cols-1 gap-6 border-t border-ink-800 pt-10 lg:grid-cols-[220px_1fr]" style={`animation-delay: ${index * 80}ms`}>
          <div>
            <p class="flex items-center gap-2 font-mono text-2xs uppercase tracking-[0.15em] text-signal">
              {role.end === 'Present' ? (
                <span class="relative flex h-1.5 w-1.5 flex-shrink-0">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-signal opacity-60" />
                  <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-signal" />
                </span>
              ) : (
                <span class="h-1.5 w-1.5 flex-shrink-0 rounded-full bg-signal/50" />
              )}
              {role.start} - {role.end}
            </p>
            <h3 class="mt-2 text-lg font-semibold text-ink-50">{role.company}</h3>
            <p class="mt-1 text-sm text-ink-400">{role.title}</p>
            <p class="mt-1 text-sm text-ink-500">{role.location}</p>
          </div>

          <div>
            <p class="text-ink-200">{role.summary}</p>
            <ul class="mt-5 space-y-3">
              {role.highlights.map((point) => (
                <li class="flex gap-3 text-sm leading-relaxed text-ink-300">
                  <span class="mt-2 h-1 w-1 flex-shrink-0 rounded-full bg-ink-500" aria-hidden="true" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
            <div class="mt-6 flex flex-wrap gap-2">
              {role.tech.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>
          </div>
        </li>
      ))
    }

    <li class="reveal grid grid-cols-1 gap-6 border-t border-ink-800 pt-10 lg:grid-cols-[220px_1fr]">
      <div>
        <p class="font-mono text-2xs uppercase tracking-[0.15em] text-ink-500">
          {education.start} - {education.end}
        </p>
        <h3 class="mt-2 text-lg font-semibold text-ink-50">{education.school}</h3>
        <p class="mt-1 text-sm text-ink-400">{education.degree}</p>
      </div>
      <div />
    </li>
  </ol>
</section>
