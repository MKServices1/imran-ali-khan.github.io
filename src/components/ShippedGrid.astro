---
import { shipped } from '@/data/projects';
import StoreLinks from '@/components/StoreLinks.astro';
---

<div>
  <h3 class="text-lg font-semibold text-ink-50">Also shipped</h3>
  <p class="mt-2 max-w-xl text-sm text-ink-400">
    More production apps built and released across client and internal projects, mostly Dubai real estate CRMs and a handful of consumer apps.
  </p>

  <ul class="mt-8 grid grid-cols-1 gap-px overflow-hidden rounded-xl border border-ink-800 bg-ink-800 sm:grid-cols-2 lg:grid-cols-3">
    {
      shipped.map((app) => (
        <li class="reveal bg-ink-950 p-5 transition-colors hover:bg-ink-900">
          <p class="font-medium text-ink-100">{app.name}</p>
          {app.category && <p class="mt-1 text-xs text-ink-500">{app.category}</p>}
          <div class="mt-4">
            <StoreLinks links={app.links} name={app.name} />
          </div>
        </li>
      ))
    }
  </ul>
</div>
